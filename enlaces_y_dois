// ==========================================
// Funciones de utilidad para acceder a los datos
// ==========================================

/**
 * Devuelve el repositorio principal actual.
 */
function getMainRepo() {
  return CorpusRG.mainRepo;
}

/**
 * Devuelve un array con todos los enlaces de GitHub.
 */
function getAllGitHubRepos() {
  return CorpusRG.githubRepos;
}

/**
 * Busca repositorios que contengan una palabra clave.
 * Ejemplo: getRepoByKeyword('geometria') o getRepoByKeyword('abc')
 */
function getRepoByKeyword(keyword) {
  return CorpusRG.githubRepos.filter(url => 
    url.toLowerCase().includes(keyword.toLowerCase())
  );
}

/**
 * Devuelve todos los DOIs de Zenodo en un solo array.
 */
function getAllZenodoDOIs() {
  return [...CorpusRG.zenodoDOIs, ...CorpusRG.zenodoMappedDOIs];
};
/**
 * Genera un enlace HTML para el repositorio principal.
 */
function renderMainRepoHTML() {
  return `<a href="${CorpusRG.mainRepo}" target="_blank" class="btn-primary">
            🚀 Ir al Repositorio Principal
          </a>`;
}

