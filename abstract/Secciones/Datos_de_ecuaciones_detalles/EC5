```python
import numpy as np
import matplotlib.pyplot as plt

# --- 1. Definición de parámetros ---
D = 1.5  # Deuda de Información
N = 100  # Número de nodos de la red

# --- 2. Definición de la Ecuación (5) ---
def V_theta(theta, D, N):
    # Ecuación (5) de Geometría Relacional
    termino = (theta / np.pi)**4 - 2*(theta / np.pi)**2 + 1
    return (D / N) * termino

# --- 3. Generación de datos y análisis ---
# Creamos un rango de fases desde -2*pi hasta 2*pi
theta_vals = np.linspace(-2 * np.pi, 2 * np.pi, 500)
V_vals = V_theta(theta_vals, D, N)

# Encontramos los puntos críticos analíticamente
V_max = V_theta(0, D, N)
V_min = V_theta(np.pi, D, N)
barrera = V_max - V_min

print(f"--- Análisis del Potencial ---")
print(f"Falso vacío (theta = 0): V(0) = {V_max:.4f}")
print(f"Vacío verdadero (theta = ±pi): V(pi) = {V_min:.4f}")
print(f"Barrera de energía (Delta V): {barrera:.4f}")

