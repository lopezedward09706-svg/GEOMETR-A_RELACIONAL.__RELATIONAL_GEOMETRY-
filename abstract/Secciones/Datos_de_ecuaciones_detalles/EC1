Python

(Usando sympy para representación simbólica y algebraica del formalismo cuántico)

```python
import sympy as sp
from sympy.physics.quantum import Ket, Bra, Operator
from sympy.physics.quantum.dagger import Dagger

# 1. Definición simbólica
H_hat = Operator('H')
zero_ket = Ket(0)

# Condición 1: Autovalor cero (Energía nula)
# H_hat * |0> = 0 * |0> -> simplifica a 0
energia_cero = H_hat * zero_ket 
# Nota: En SymPy se representa como una aplicación, 
# asumimos que es el estado propio con autovalor 0.

# Condición 2: Normalización
# <0|0> = 1
normalizacion = Bra(0) * zero_ket
print(f"Estado cuántico: {zero_ket}")
print(f"Producto interno (debe ser 1): {normalizacion}")

# Condición 3: Dimensión del subespacio
# dim(H_0) = 1
dim_H0 = 1
print(f"Dimensión del espacio nulo (H_0): {dim_H0}")

# ---------------------------------------------------------
# Ejemplo numérico (Matriz de 2x2 para ilustrar el concepto)
# ---------------------------------------------------------
import numpy as np

# Supongamos un sistema simplificado de 2 niveles donde el estado base es el vector [1, 0]
H_matrix = np.array([[0, 0], [0, 1]]) # Autovalores 0 y 1
ket_0 = np.array([[1], [0]])

# Verificando H|0> = 0
resultado_H = np.dot(H_matrix, ket_0)
print(f"\nEjemplo Numérico:")
print(f"H|0> = \n{resultado_H}")

# Verificando <0|0> = 1
norma = np.dot(ket_0.T, ket_0)[0,0]
print(f"<0|0> = {norma}")

# Verificando dim(H_0) = 1
# El espacio nulo (null space) de H_matrix tiene dimensión 1
rango = np.linalg.matrix_rank(H_matrix)
dim_espacio_nulo = H_matrix.shape[0] - rango
print(f"dim(H_0) = {dim_espacio_nulo}")
```
