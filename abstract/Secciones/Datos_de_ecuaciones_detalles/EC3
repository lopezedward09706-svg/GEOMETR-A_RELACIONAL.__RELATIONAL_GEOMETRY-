Python

(Representación simbólica con sympy y una simulación numérica clásica con numpy para calcular la energía de una red)

```python
import sympy as sp
import numpy as np

# 1. Representación Simbólica
theta_i, theta_j = sp.symbols('theta_i theta_j', real=True)
# Término de interacción para un solo enlace
termino_interaccion = 1 - sp.cos(theta_i - theta_j)
print("Término de interacción simbólico:")
sp.pprint(termino_interaccion)

# ---------------------------------------------------------
# 2. Simulación Numérica (Red 1D clásica de 5 nodos)
# ---------------------------------------------------------
N = 5
# Definimos fases aleatorias entre 0 y 2*pi
fases = np.random.uniform(0, 2 * np.pi, N)

def calcular_energia(fases_nodos):
    energia_total = 0
    # Suma sobre vecinos adyacentes en una red 1D (condiciones periódicas)
    for i in range(len(fases_nodos)):
        j = (i + 1) % len(fases_nodos) # Vector al siguiente nodo
        diff_fase = fases_nodos[i] - fases_nodos[j]
        # Término de la ecuación (3)
        energia_total += 1 - np.cos(diff_fase)
    return energia_total

energia = calcular_energia(fases)
print(f"\nFases de los nodos: {np.round(fases, 2)}")
print(f"Energía total de la red H: {energia:.4f}")

# Caso de Silencio Armónico (todas las fases iguales)
fases_silencio = np.zeros(N)
energia_silencio = calcular_energia(fases_silencio)
print(f"\nEnergía en Silencio Armónico (fases iguales): {energia_silencio:.4f}")
```
